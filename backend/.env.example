# 后端环境变量样例（docs/api.md 第 7 节）。复制为 .env 后填写；.env 不进仓库。

# DeepSeek：只在后端使用，前端永远拿不到
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 数据库：本地 / CI 用 SQLite 文件；线上填 Neon 的 postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/baker.db

# JWT 签名密钥：必填，缺失时启动直接报错；HS256 要求至少 32 字节，可用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 每个用户每天（UTC+8）最多发送的消息数
DAILY_MESSAGE_LIMIT=100

# 启动时不存在则创建的演示账号
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# 1 时不调用上游，返回固定 mock 回复（E2E、CI、无 Key 演示）
AI_MOCK=0
