  "cards": [
    {
      "dot": "cyan",
      "title": "主路径：一次消息穿过四层",
      "items": [
        "lib/http.ts 带 Bearer JWT 发出 JSON 请求",
        "deps.py 校验令牌与会话归属，跨用户一律 404",
        "chat.py 组装 2 条 system + 最近 40 条上下文，ai.py 转发 DeepSeek",
        "{delta} 帧以 text/event-stream 回到浏览器并切行"
      ]
    },
    {
      "dot": "amber",
      "title": "两次落库都不依赖流是否成功",
      "items": [
        "准入通过就先 commit 用户消息，上游失败也不会丢",
        "流无论正常、出错、stop 还是客户端断开，都在 finally 里同步落库",
        "会话在流进行中被删除时不写任何一行，避免孤儿消息"
      ]
    },
    {
      "dot": "violet",
      "title": "进程内状态与它的边界",
      "items": [
        "active_streams 是进程内字典，只在单个后端实例内可见",
        "/chat/stop 置位 stop 并等 finished，即等落库完成才返回",
        "角色提示词与 API Key 都只在后端，前端拿不到"
      ]
    }
  ]
